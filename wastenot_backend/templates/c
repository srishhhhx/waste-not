<!-- Add this near the QR code button for donors -->
{% if user.is_authenticated and user == item.donor %}
    <div class="mt-4 flex space-x-4">
        <a href="{% url 'item_qr_code' item.id %}" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded">
            View QR Code for Pickup
        </a>
        <a href="{% url 'delete_item' item.id %}" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" 
           onclick="return confirm('Are you sure you want to delete this item? This action cannot be undone.')">
            Delete Item
        </a>
    </div>
{% endif %}